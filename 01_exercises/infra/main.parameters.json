{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "servicePrincipalId": {
      "value": "${AZURE_SERVICE_PRINCIPAL_ID=}"
    },
    "owner": {
      "value": "${OWNER_EMAIL}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "chatDeploymentSkuName": {
      "value": "${AZURE_OPENAI_CHAT_DEPLOYMENT_SKU=GlobalStandard}"
    },
    "existingOpenAIAccountName": {
      "value": "${AZURE_OPENAI_ACCOUNT_NAME=}"
    },
    "existingOpenAIResourceGroupName": {
      "value": "${AZURE_OPENAI_RESOURCE_GROUP_NAME=}"
    },
    "existingOpenAIEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT=}"
    }
  }
}

